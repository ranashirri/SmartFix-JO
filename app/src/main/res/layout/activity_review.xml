<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/bg_light"
    android:gravity="center_horizontal">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/ic_launcher_foreground" /> <!-- You can swap this for a green checkmark later! -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Job Completed!"
        android:textColor="@color/brand_dark_blue"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="How was your experience with Mahmoud?"
        android:textColor="#666666"
        android:textSize="16sp"
        android:textAlignment="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"/>

    <!-- THE STAR RATING -->
    <RatingBar
        android:id="@+id/ratingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:numStars="5"
        android:stepSize="1.0"
        android:rating="5.0"
        android:progressTint="#FFC107"
        android:layout_marginBottom="32dp"/>

    <!-- PAYMENT INPUT -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/brand_green"
        app:hintTextColor="@color/brand_green"
        android:layout_marginBottom="32dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFinalPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Final Amount Paid (JOD)"
            android:inputType="numberDecimal"
            android:textSize="18sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- SUBMIT BUTTON -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitReview"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="SUBMIT &amp; RETURN HOME"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/brand_dark_blue"
        android:layout_marginBottom="16dp"/>

</LinearLayout>