<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">

    <!-- 1. THE REAL INTERACTIVE MAP -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. THE BOTTOM SHEET (Driver Info) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        android:layout_marginBottom="-10dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

            <TextView android:id="@+id/tvSheetTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Locating nearby technicians..." android:textColor="@color/brand_dark_blue" android:textSize="20sp" android:textStyle="bold"/>

            <LinearLayout android:id="@+id/techDetailsLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp" android:visibility="gone" android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    app:cardCornerRadius="30dp"
                    app:cardBackgroundColor="@color/brand_green">
                    <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:text="👷" android:textSize="30sp" android:gravity="center"/>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="16dp">
                    <TextView android:id="@+id/tvTechName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mahmoud A." android:textSize="18sp" android:textStyle="bold" android:textColor="@color/brand_dark_blue"/>
                    <TextView android:id="@+id/tvTechDetails" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⭐ 4.9 (120 jobs) • Honda Civic" android:textSize="14sp" android:textColor="#666666"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 min" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/brand_green"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallTech"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:text="CALL TECHNICIAN"
                android:visibility="gone"
                app:backgroundTint="@color/brand_green"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelSearch"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                android:text="CANCEL REQUEST"
                android:textColor="#FF3B30"
                app:backgroundTint="#20FF3B30"
                app:cornerRadius="12dp"
                app:elevation="0dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>